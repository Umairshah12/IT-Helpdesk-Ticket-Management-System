# ==============================================================
# HELPDESK PRO – ENTERPRISE IT SERVICE MANAGEMENT PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpdesk_pro?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=helpdesk_pro
DB_PORT=5432

# Security & Authentication
JWT_ACCESS_SECRET=super_secure_jwt_access_secret_key_change_in_production_1234567890
JWT_REFRESH_SECRET=super_secure_jwt_refresh_secret_key_change_in_production_0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Seed
SUPER_ADMIN_NAME="System Super Administrator"
SUPER_ADMIN_EMAIL=superadmin@helpdeskpro.internal
SUPER_ADMIN_PASSWORD=SuperAdmin@Secure2026!
SUPER_ADMIN_EMPLOYEE_ID=EMP-0001

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# SLA Defaults (Business Hours)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
TIMEZONE=UTC

