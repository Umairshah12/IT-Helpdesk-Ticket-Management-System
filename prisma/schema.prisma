// Prisma Schema for Helpdesk Pro ITSM Platform
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_USER
  PENDING_THIRD_PARTY
  RESOLVED
  CLOSED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  employeeId       String       @unique
  phone            String?
  role             Role         @default(EMPLOYEE)
  status           UserStatus   @default(ACTIVE)
  designation      String?
  avatarUrl        String?
  joiningDate      DateTime?    @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  departmentId     String?
  department       Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepts     Department[] @relation("DepartmentManager")

  requestedTickets Ticket[]     @relation("TicketRequester")
  assignedTickets  Ticket[]     @relation("TicketAssignee")
  comments         TicketComment[]
  attachments      TicketAttachment[]
  assignmentsMade  TicketAssignment[] @relation("AssignedBy")
  activities       TicketActivity[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  ratingsGiven     ServiceRating[] @relation("RequesterRatings")
  ratingsReceived  ServiceRating[] @relation("TechnicianRatings")

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@map("users")
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  managerId   String?
  manager     User?     @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  members     User[]    @relation("DepartmentMembers")
  tickets     Ticket[]

  @@index([isActive])
  @@map("departments")
}

model TicketCategory {
  id              String         @id @default(uuid())
  name            String         @unique
  code            String         @unique
  description     String?
  defaultPriority TicketPriority @default(MEDIUM)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tickets         Ticket[]

  @@index([isActive])
  @@map("ticket_categories")
}

model SLAPolicy {
  id                    String         @id @default(uuid())
  name                  String         @unique
  description           String?
  priority              TicketPriority @unique
  responseTimeMinutes   Int
  resolutionTimeMinutes Int
  isBusinessHoursOnly   Boolean        @default(true)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tickets               Ticket[]

  @@index([priority])
  @@map("sla_policies")
}

model Ticket {
  id                 String         @id @default(uuid())
  ticketNumber       String         @unique // e.g. TKT-2026-0001
  title              String
  description        String         @db.Text
  priority           TicketPriority @default(MEDIUM)
  status             TicketStatus   @default(OPEN)
  location           String?
  responseDueAt      DateTime?
  resolutionDueAt    DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  isOverdue          Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  categoryId         String
  category           TicketCategory @relation(fields: [categoryId], references: [id])

  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  requesterId        String
  requester          User           @relation("TicketRequester", fields: [requesterId], references: [id])

  assigneeId         String?
  assignee           User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  slaPolicyId        String?
  slaPolicy          SLAPolicy?     @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  comments           TicketComment[]
  attachments        TicketAttachment[]
  assignments        TicketAssignment[]
  activities         TicketActivity[]
  rating             ServiceRating?

  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([departmentId])
  @@index([createdAt])
  @@index([isOverdue])
  @@map("tickets")
}

model TicketComment {
  id          String       @id @default(uuid())
  content     String       @db.Text
  isInternal  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([authorId])
  @@index([isInternal])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String         @id @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  fileUrl      String
  createdAt    DateTime       @default(now())

  ticketId     String
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketAssignment {
  id                 String    @id @default(uuid())
  previousAssigneeId String?
  newAssigneeId      String?
  reason             String?
  createdAt          DateTime  @default(now())

  ticketId           String
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  assignedById       String
  assignedBy         User      @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([ticketId])
  @@map("ticket_assignments")
}

model TicketActivity {
  id           String    @id @default(uuid())
  actionType   String    // e.g. CREATED, ASSIGNED, STATUS_CHANGED, COMMENT_ADDED, PRIORITY_CHANGED, RESOLVED, REOPENED
  fieldChanged String?
  oldValue     String?   @db.Text
  newValue     String?   @db.Text
  description  String    @db.Text
  metadata     Json?
  createdAt    DateTime  @default(now())

  ticketId     String
  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId      String
  actor        User      @relation(fields: [actorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@map("ticket_activities")
}

model Notification {
  id         String    @id @default(uuid())
  title      String
  message    String    @db.Text
  type       String    // e.g. TICKET_ASSIGNED, STATUS_UPDATED, SLA_BREACH, NEW_COMMENT
  entityType String?   // TICKET, USER, SYSTEM
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g. USER_LOGIN, USER_CREATED, ROLE_CHANGE, POLICY_UPDATED
  entity    String   // USER, TICKET, SLA, DEPARTMENT
  entityId  String?
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model ServiceRating {
  id           String   @id @default(uuid())
  rating       Int      // 1 to 5
  feedback     String?  @db.Text
  createdAt    DateTime @default(now())

  ticketId     String   @unique
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  requesterId  String
  requester    User     @relation("RequesterRatings", fields: [requesterId], references: [id])

  technicianId String?
  technician   User?    @relation("TechnicianRatings", fields: [technicianId], references: [id])

  @@index([technicianId])
  @@index([rating])
  @@map("service_ratings")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

